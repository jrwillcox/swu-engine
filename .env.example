# Copy to .env (gitignored) or export these in your shell. Every variable is
# optional — the app runs with none of them set.

# ── Data ──────────────────────────────────────────────────────────────────────
# Path to the card database. Its parent directory is also used as the data dir
# (card images, saves, user accounts). Defaults to <repo>/data/swu.db.
#SWU_DB=data/swu.db

# ── Accounts ──────────────────────────────────────────────────────────────────
# Comma-separated usernames allowed to register (case-insensitive).
# Unset => a single account named "player". Set but empty => registration closed.
#SWU_ALLOWED_USERS=player
# Subset of the above granted admin rights. Unset => the first allowed user.
#SWU_ADMIN_USERS=player
# Override where per-user data is stored (all default under the data dir).
#SWU_USERS=data/users.json
#SWU_UI_DECKS=data/ui_decks.json
#SWU_CUSTOM_DECKS=data/custom_decks

# ── LLM opponent (optional — Normal/Hard difficulties) ────────────────────────
# Without a key, Normal/Hard fall back to the heuristic bot and say so in the
# in-game log. Easy never calls the API at all.
#ANTHROPIC_API_KEY=sk-ant-...
#SWU_LLM_MODEL=claude-haiku-4-5
#SWU_LLM_TIMEOUT=20

# ── Bots ──────────────────────────────────────────────────────────────────────
# Heuristic bot weight overrides, for scripts/bot_arena.py experiments.
#SWU_BOT_TUNE=

# ── Front end (read by web/vite.config.ts) ────────────────────────────────────
#SWU_PORT=5173
#SWU_API=http://127.0.0.1:8000
# Hostnames allowed to reach the dev/preview server by name. IP addresses always
# work; set this only if you browse to http://<hostname>:<port> from another
# device on your LAN.
#SWU_ALLOWED_HOSTS=mybox.local,mybox
#VITE_APP_VERSION=dev
